# Copy to supabase/functions/.env for `npm run functions:serve`, and set the same values with
# `npx supabase secrets set` on the hosted project. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are
# injected by Supabase automatically; do not set them here.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STUDENT_EMAIL_DOMAIN=tdsb.ca
